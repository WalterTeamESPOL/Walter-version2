# OpenAI API Key (REQUERIDO)
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Integración con Walter (OPCIONAL - default: false)
# Habilitar/deshabilitar control de movimientos de Walter
NEXT_PUBLIC_WALTER_ENABLED=false

# URL del servidor walter_web
# Este servidor debe estar corriendo en el puerto especificado (por defecto 3002)
NEXT_PUBLIC_WALTER_SERVER_URL=http://localhost:3002
